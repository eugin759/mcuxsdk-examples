# end of Infrastructure

#
# Callback-style APIs
#

#
# RAW
#
CONFIG_LWIP_RAW=y
CONFIG_RAW_TTL=255
# end of RAW

#
# DNS
#
CONFIG_LWIP_DNS=y
CONFIG_DNS_TABLE_SIZE=4
CONFIG_DNS_MAX_NAME_LENGTH=256
CONFIG_DNS_MAX_SERVERS=2
CONFIG_DNS_MAX_RETRIES=4
CONFIG_DNS_DOES_NAME_CHECK=y
CONFIG_LWIP_DNS_SECURE="(LWIP_DNS_SECURE_RAND_XID | LWIP_DNS_SECURE_NO_MULTIPLE_OUTSTANDING | LWIP_DNS_SECURE_RAND_SRC_PORT)"
# CONFIG_DNS_LOCAL_HOSTLIST is not set
# CONFIG_DNS_LOCAL_HOSTLIST_IS_DYNAMIC is not set
# CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES is not set
# end of DNS

#
# UDP
#
CONFIG_LWIP_UDP=y
# CONFIG_LWIP_UDPLITE is not set
CONFIG_UDP_TTL=255
# CONFIG_LWIP_NETBUF_RECVINFO is not set
# end of UDP

#
# TCP
#
CONFIG_LWIP_TCP=y
CONFIG_TCP_TTL=255
CONFIG_TCP_WND="(2 * TCP_MSS)"
CONFIG_TCP_MAXRTX=12
CONFIG_TCP_SYNMAXRTX=6
# CONFIG_TCP_QUEUE_OOSEQ is not set
# CONFIG_LWIP_TCP_SACK_OUT is not set
CONFIG_LWIP_TCP_MAX_SACK_NUM=4
CONFIG_TCP_MSS=1460
CONFIG_TCP_CALCULATE_EFF_SEND_MSS=y
CONFIG_LWIP_TCP_RTO_TIME=3000
CONFIG_TCP_SND_BUF="(6 * TCP_MSS)"
CONFIG_TCP_SND_QUEUELEN="((3 * TCP_SND_BUF) / TCP_MSS)"
CONFIG_TCP_SNDLOWAT="LWIP_MIN(LWIP_MAX(((TCP_SND_BUF)/2), (2 * TCP_MSS) + 1), (TCP_SND_BUF) - 1)"
CONFIG_TCP_SNDQUEUELOWAT="LWIP_MAX(((TCP_SND_QUEUELEN)/2), 5)"
CONFIG_TCP_OOSEQ_MAX_PBUFS=0
CONFIG_TCP_LISTEN_BACKLOG=y
CONFIG_TCP_DEFAULT_LISTEN_BACKLOG=0xff
CONFIG_TCP_OVERSIZE=1460
# CONFIG_LWIP_TCP_TIMESTAMPS is not set
CONFIG_TCP_WND_UPDATE_THRESHOLD="LWIP_MIN((TCP_WND / 4), (TCP_MSS * 4))"
CONFIG_LWIP_CALLBACK_API=y
# CONFIG_LWIP_WND_SCALE is not set
CONFIG_LWIP_TCP_PCB_NUM_EXT_ARGS=0
# CONFIG_LWIP_ALTCP is not set
# end of TCP
# end of Callback-style APIs

#
# Thread-safe APIs
#

#
# Netconn
#
CONFIG_LWIP_NETCONN=y
# CONFIG_LWIP_TCPIP_TIMEOUT is not set
# CONFIG_LWIP_NETCONN_SEM_PER_THREAD is not set
# CONFIG_LWIP_NETCONN_FULLDUPLEX is not set
# end of Netconn

#
# Sockets
#
CONFIG_LWIP_SOCKET=y
CONFIG_LWIP_COMPAT_SOCKETS=1
CONFIG_LWIP_POSIX_SOCKETS_IO_NAMES=y
CONFIG_LWIP_SOCKET_OFFSET=0
# CONFIG_LWIP_SOCKET_EXTERNAL_HEADERS is not set
# CONFIG_LWIP_TCP_KEEPALIVE is not set
# CONFIG_LWIP_SO_SNDTIMEO is not set
CONFIG_LWIP_SO_RCVTIMEO=y
# CONFIG_LWIP_TCP_USER_TIMEOUT is not set
# CONFIG_LWIP_SO_SNDRCVTIMEO_NONSTANDARD is not set
# CONFIG_LWIP_SO_RCVBUF is not set
# CONFIG_LWIP_SIOCOUTQ is not set
# CONFIG_LWIP_SO_LINGER is not set
CONFIG_RECV_BUFSIZE_DEFAULT="INT_MAX"
CONFIG_LWIP_TCP_CLOSE_TIMEOUT_MS_DEFAULT=20000
# CONFIG_SO_REUSE is not set
# CONFIG_SO_REUSE_RXTOALL is not set
CONFIG_LWIP_FIONREAD_LINUXMODE=0
CONFIG_LWIP_SOCKET_SELECT=y
CONFIG_LWIP_SOCKET_POLL=y
# end of Sockets
# end of Thread-safe APIs


CONFIG_MCUX_COMPONENT_middleware.freertos-kernel=y
# CONFIG_MCUX_MISC_middleware.freertos-kernel.dynamic_allocator.none is not set
# CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.heap_1 is not set
# CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.heap_2 is not set
CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.heap_3=y
# CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.heap_4 is not set
# CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.heap_5 is not set
# CONFIG_MCUX_MISC_middleware.freertos-kernel.heap_custom is not set
CONFIG_MCUX_PRJSEG_middleware.freertos-kernel.generated_config=y
CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.config=y
# CONFIG_FREERTOS_USE_CUSTOM_CONFIG_FRAGMENT is not set

#
# Configuration (FreeRTOSConfig_Gen.h)
#
CONFIG_configCPU_CLOCK_HZ="(SystemCoreClock)"
CONFIG_configTICK_RATE_HZ=1000
CONFIG_configUSE_PREEMPTION=y
# CONFIG_configUSE_TIME_SLICING is not set
# CONFIG_configUSE_PORT_OPTIMISED_TASK_SELECTION is not set
CONFIG_configUSE_TICKLESS_IDLE=0
CONFIG_configMAX_PRIORITIES=18
CONFIG_configMINIMAL_STACK_SIZE=90
CONFIG_configMAX_TASK_NAME_LEN=13
# CONFIG_configUSE_16_BIT_TICKS is not set
CONFIG_configIDLE_SHOULD_YIELD=y
CONFIG_configTASK_NOTIFICATION_ARRAY_ENTRIES=1
CONFIG_configQUEUE_REGISTRY_SIZE=8
# CONFIG_configENABLE_BACKWARD_COMPATIBILITY is not set
CONFIG_configNUM_THREAD_LOCAL_STORAGE_POINTERS=5
CONFIG_configUSE_MINI_LIST_ITEM=y
CONFIG_configSTACK_DEPTH_TYPE="size_t"
CONFIG_configMESSAGE_BUFFER_LENGTH_TYPE="size_t"
CONFIG_configUSE_EVENT_GROUPS=y
CONFIG_configUSE_STREAM_BUFFERS=y
CONFIG_configPROTECTED_KERNEL_OBJECT_POOL_SIZE=10
# CONFIG_configHEAP_CLEAR_MEMORY_ON_FREE is not set
# CONFIG_configUSE_NEWLIB_REENTRANT is not set
# CONFIG_configUSE_PICOLIBC_TLS is not set
CONFIG_configINCLUDE_FREERTOS_TASK_C_ADDITIONS_H=y
# CONFIG_configRECORD_STACK_HIGH_ADDRESS is not set
CONFIG_configUSE_TIMERS=y
CONFIG_configTIMER_TASK_PRIORITY="17"
CONFIG_configTIMER_TASK_STACK_DEPTH="(configMINIMAL_STACK_SIZE * 2)"
CONFIG_configTIMER_QUEUE_LENGTH=10
CONFIG_configSUPPORT_DYNAMIC_ALLOCATION=y
# CONFIG_configAPPLICATION_ALLOCATED_HEAP is not set
# CONFIG_configSTACK_ALLOCATION_FROM_SEPARATE_HEAP is not set
# CONFIG_configENABLE_HEAP_PROTECTOR is not set
CONFIG_configTOTAL_HEAP_SIZE=0
CONFIG_configFRTOS_MEMORY_SCHEME=3
# CONFIG_configSUPPORT_STATIC_ALLOCATION is not set
CONFIG_configMINIMAL_SECURE_STACK_SIZE=256
CONFIG_configPRIO_BITS=3
CONFIG_configOVERRIDE_DEFAULT_TICK_CONFIGURATION=0
CONFIG_configLPTMR_CLOCK_HZ=0
CONFIG_configLIBRARY_LOWEST_INTERRUPT_PRIORITY="((1U << (configPRIO_BITS)) - 1U)"
CONFIG_configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY=2
CONFIG_configLOGGING_MAX_MESSAGE_LENGTH=256
CONFIG_configLOGGING_INCLUDE_TIME_AND_TASK_NAME=y
CONFIG_configKERNEL_INTERRUPT_PRIORITY="(configLIBRARY_LOWEST_INTERRUPT_PRIORITY << (8 - configPRIO_BITS))"
CONFIG_configMAX_SYSCALL_INTERRUPT_PRIORITY="(configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY << (8 - configPRIO_BITS))"
CONFIG_configMAX_API_CALL_INTERRUPT_PRIORITY="(configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY << (8 - configPRIO_BITS))"
# CONFIG_configUSE_IDLE_HOOK is not set
# CONFIG_configUSE_TICK_HOOK is not set
# CONFIG_configCHECK_FOR_STACK_OVERFLOW is not set
# CONFIG_configUSE_MALLOC_FAILED_HOOK is not set
# CONFIG_configUSE_DAEMON_TASK_STARTUP_HOOK is not set
# CONFIG_configUSE_SB_COMPLETED_CALLBACK is not set
# CONFIG_configGENERATE_RUN_TIME_STATS is not set
CONFIG_configUSE_TRACE_FACILITY=y
CONFIG_configUSE_STATS_FORMATTING_FUNCTIONS=y
# CONFIG_configUSE_CO_ROUTINES is not set
CONFIG_configMAX_CO_ROUTINE_PRIORITIES=2
CONFIG_configASSERT(x)="if((x) == 0) {taskDISABLE_INTERRUPTS(); for (;;);}"
# CONFIG_configINCLUDE_APPLICATION_DEFINED_PRIVILEGED_FUNCTIONS is not set
CONFIG_configTOTAL_MPU_REGIONS=8
CONFIG_configTEX_S_C_B_FLASH="0x07UL"
CONFIG_configTEX_S_C_B_SRAM="0x07UL"
# CONFIG_configENFORCE_SYSTEM_CALLS_FROM_KERNEL_ONLY is not set
CONFIG_configALLOW_UNPRIVILEGED_CRITICAL_SECTIONS=y
CONFIG_configSYSTEM_CALL_STACK_SIZE=128
# CONFIG_configENABLE_ACCESS_CONTROL_LIST is not set
CONFIG_configNUMBER_OF_CORES=1
# CONFIG_configRUN_MULTIPLE_PRIORITIES is not set
# CONFIG_configUSE_CORE_AFFINITY is not set
CONFIG_configTASK_DEFAULT_CORE_AFFINITY="(tskNO_AFFINITY)"
# CONFIG_configUSE_TASK_PREEMPTION_DISABLE is not set
# CONFIG_configUSE_PASSIVE_IDLE_HOOK is not set
CONFIG_configTIMER_SERVICE_TASK_CORE_AFFINITY="(tskNO_AFFINITY)"
CONFIG_secureconfigMAX_SECURE_CONTEXTS=8
# CONFIG_configKERNEL_PROVIDED_STATIC_MEMORY is not set
# CONFIG_configENABLE_TRUSTZONE is not set
CONFIG_configRUN_FREERTOS_SECURE_ONLY=y
# CONFIG_configENABLE_MPU is not set
CONFIG_configENABLE_FPU=y
# CONFIG_configENABLE_MVE is not set
CONFIG_configCHECK_HANDLER_INSTALLATION=y
CONFIG_configTASK_RETURN_ADDRESS="(prvTaskExitError)"
CONFIG_configUSE_TASK_NOTIFICATIONS=y
CONFIG_configUSE_MUTEXES=y
CONFIG_configUSE_RECURSIVE_MUTEXES=y
CONFIG_configUSE_COUNTING_SEMAPHORES=y
# CONFIG_configUSE_QUEUE_SETS is not set
# CONFIG_configUSE_APPLICATION_TASK_TAG is not set
CONFIG_INCLUDE_vTaskPrioritySet=y
CONFIG_INCLUDE_uxTaskPriorityGet=y
CONFIG_INCLUDE_vTaskDelete=y
CONFIG_INCLUDE_vTaskSuspend=y
CONFIG_INCLUDE_vTaskDelayUntil=y
CONFIG_INCLUDE_vTaskDelay=y
CONFIG_INCLUDE_xTaskGetSchedulerState=y
CONFIG_INCLUDE_xTaskGetCurrentTaskHandle=y
# CONFIG_INCLUDE_uxTaskGetStackHighWaterMark is not set
CONFIG_INCLUDE_uxTaskGetStackHighWaterMark2=y
# CONFIG_INCLUDE_xTaskGetIdleTaskHandle is not set
# CONFIG_INCLUDE_eTaskGetState is not set
CONFIG_INCLUDE_xTimerPendFunctionCall=y
# CONFIG_INCLUDE_xTaskAbortDelay is not set
CONFIG_INCLUDE_xSemaphoreGetMutexHolder=y
# CONFIG_INCLUDE_xTaskGetHandle is not set
CONFIG_INCLUDE_xTaskResumeFromISR=y
CONFIG_vPortSVCHandler="SVC_Handler"
CONFIG_xPortPendSVHandler="PendSV_Handler"
CONFIG_xPortSysTickHandler="SysTick_Handler"
# end of Configuration (FreeRTOSConfig_Gen.h)

CONFIG_MCUX_COMPONENT_middleware.freertos-kernel.cm33_non_trustzone=y
